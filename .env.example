# Google Cloud Project credentials
# Copy this file to .env and fill in your values

# Google API Key (from Google Cloud Console > APIs & Services > Credentials)
VITE_GOOGLE_API_KEY=

# OAuth 2.0 Client ID (from Google Cloud Console > APIs & Services > Credentials)
VITE_GOOGLE_CLIENT_ID=

# Google Cloud Project Number (found on Google Cloud Console > Project Settings)
VITE_GOOGLE_APP_ID=

# OAuth Scope (default: drive.readonly)
# VITE_GOOGLE_SCOPE=https://www.googleapis.com/auth/drive.readonly
